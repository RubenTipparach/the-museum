// "Hall Six" : the Elmorian exhibit after hours.
// Slow, dark and mostly empty, in the manner of Riven's rooms: a low drone
// that never quite resolves, pads in D Phrygian (the E flat against the D is
// the unease), a reed voice that says four notes and then waits, a deep drum
// somewhere far off, and water dripping in a room you cannot see.
// One cycle is four seconds; the render is 40 cycles, 160 s, and loops.
setcps(0.25)

stack(
  // the drone: two detuned saws under a heavy low pass, breathing
  note("<d1 d1 d1 c1>").s("sawtooth").lpf(160).attack(2.5).release(3.5).sustain(0.8).gain(0.32).room(0.6).roomsize(6),
  note("<d1 d1 eb1 d1>").s("triangle").lpf(220).attack(3).release(3).sustain(0.7).gain(0.22).pan(0.4),

  // the pads: dorian and phrygian colours, very slow attack, long tails
  note("<[d3,a3,c4] [d3,f3,a3] [bb2,d3,f3] [eb3,g3,bb3] [d3,f3,a3,c4] [c3,eb3,g3] [d3,a3,d4] [eb3,g3,bb3]>")
    .s("triangle").lpf("<700 900 600 800>").attack(1.6).decay(1.0).sustain(0.55).release(3.2).gain(0.3).room(0.9).roomsize(7),

  // a high shimmer, barely there, on every fourth cycle
  note("<~ ~ ~ [a5,bb5]>").s("sine").attack(1.5).release(3).gain(0.07).room(0.95).roomsize(8).pan("<0.3 0.7>"),

  // the reed: a phrase, then silence, then a different phrase
  note("<[~ ~ a4 ~] [g4 ~ f4 ~] [~ ~ ~ ~] [eb4 ~ ~ d4] [~ ~ ~ ~] [~ f4 ~ g4] [a4 ~ ~ ~] [~ ~ ~ ~] [~ bb4 a4 ~] [~ ~ ~ ~]>")
    .s("triangle").lpf(1400).attack(0.25).decay(0.4).sustain(0.5).release(1.2).vib(4.5).vibmod(0.12)
    .gain(0.24).delay(0.45).delaytime(0.75).room(0.85).roomsize(6).pan(0.55),

  // the far drum: one beat, sometimes two, on the odd cycles
  s("<[bd ~ ~ ~ ~ ~ ~ ~] [~ ~ ~ ~ ~ ~ ~ ~] [bd ~ ~ ~ ~ ~ bd ~] [~ ~ ~ ~ ~ ~ ~ ~]>").lpf(180).gain(0.55).room(0.9).roomsize(8),

  // water in the dark: two drips, never in the same place
  s("<[~ ~ ~ hh ~ ~ ~ ~] [~ ~ ~ ~ ~ ~ hh ~] [~ hh ~ ~ ~ ~ ~ ~] [~ ~ ~ ~ ~ ~ ~ ~]>").lpf(4200).gain(0.14).delay(0.5).delaytime(0.62).room(0.8).pan("<0.2 0.8 0.35 0.7>")
)
