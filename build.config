# Build configuration. The single source of truth for tool versions, per
# CLAUDE.md 4.4: never repeat these in a script or a workflow. Shell syntax,
# KEY=value only, no logic. Sourced by scripts/*.sh.

# Confirmed against https://godotengine.org/download/linux/ on 2026-09-04 and
# proven to run here: see docs/ARCHITECTURE.md ADR-0.
GODOT_VERSION="4.7.1"
GODOT_RELEASE="stable"

# "mono" is the C# build. It cannot export to Web (ADR-1); this game is desktop.
GODOT_FLAVOR="mono"

# The .NET SDK the mono build compiles scripts with. Ubuntu 24.04 ships it as
# the apt package dotnet-sdk-8.0.
DOTNET_MAJOR="8"

# Where install-godot.sh puts the editor. Git ignored.
TOOLS_DIR=".tools"

# Blender, for every model in assets/ (docs/BLENDER.md). Downloaded from
# download.blender.org, which the sandbox proxy reaches; 4.2 is the LTS line.
BLENDER_VERSION="4.2.3"

# Material Maker, for every texture (CLAUDE.md 5). A Godot application, so it
# runs under Xvfb on the software GL driver the way the-federation ran Godot.
MATERIAL_MAKER_VERSION="1.4"

# --- The itch track (docs/ARCHITECTURE.md ADR-14) -------------------------------

# The GDScript editor that exports the Web build. The mono editor above cannot
# export to Web; the two live side by side in TOOLS_DIR.
ITCH_GODOT_FLAVOR="standard"

# The Godot project of the itch track, relative to the repository root.
GODOT_PROJECT_DIR="itch"

# The itch.io page, as it appears in the URL: https://<ITCH_USER>.itch.io/<ITCH_GAME>
# Confirmed by the owner (2026-09-05): https://ruben-tipparach.itch.io/the-museum
ITCH_USER="ruben-tipparach"
ITCH_GAME="the-museum"

# Which targets a bare ./scripts/build.sh exports, and which of those a bare
# ./scripts/deploy-itch.sh uploads (a subset: a target never built has nothing
# to push).
ENABLED_TARGETS="web"
DEPLOY_TARGETS="web"

# Target table, one row per target, pipe delimited:
#   name | godot preset | output subdir | output filename | butler channel
# The preset must match a name in itch/export_presets.cfg exactly; the butler
# channel is named so itch.io detects the platform.
TARGETS="
web | Web | web | index.html | html5
"

# Build output root, relative to the repository root. Git ignored.
BUILD_DIR="builds"
